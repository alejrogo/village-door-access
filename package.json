{
  "name": "village-door-access",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source village door access: Visitors record a Visit and see that Location's Access Code. Operators share one Password.",
  "homepage": "https://github.com/differentgrowth/village-door-access#readme",
  "bugs": {
    "url": "https://github.com/differentgrowth/village-door-access/issues"
  },
  "license": "MIT",
  "author": "Village Door Access / Different Growth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/differentgrowth/village-door-access.git"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "prisma generate && pnpm db:migrate && vite build",
    "check": "ultracite check",
    "db:migrate": "prisma migrate deploy",
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "fix": "ultracite fix",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "test": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test scripts/**/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "nitro": "3.0.261029-rc",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tailwindcss": "^1.17.1",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "typescript": "6.0.3",
    "ultracite": "8.1.0",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@11.21.0"
}
